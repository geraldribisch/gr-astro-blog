---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../utils/formatDate';

export async function getStaticPaths() {
	// Entwürfe bekommen keine eigene Seite
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate } = post.data;
const { Content } = await render(post);
---

<BaseLayout title={`${title} | Gerald Ribisch`} description={description}>
	<article>
		<header class="post-header">
			<a href="/blog" class="back">← Alle Beiträge</a>
			<h1>{title}</h1>
			<p class="meta">
				<time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
				{
					updatedDate && (
						<>
							{' · aktualisiert am '}
							<time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
						</>
					)
				}
			</p>
		</header>

		<div class="content">
			<Content />
		</div>
	</article>
</BaseLayout>

<style>
	.post-header {
		margin-bottom: 2rem;
	}

	.back {
		display: inline-block;
		margin-bottom: 1rem;
		font-size: 0.9rem;
		color: #0057b8;
		text-decoration: none;
	}

	.back:hover {
		text-decoration: underline;
	}

	h1 {
		line-height: 1.25;
	}

	.meta {
		margin-top: 0.5rem;
		font-size: 0.9rem;
		color: #666;
	}

	/* Markdown-Inhalt: Abstände nach dem globalen Reset wiederherstellen */
	.content :global(p),
	.content :global(ul),
	.content :global(ol),
	.content :global(blockquote) {
		margin-bottom: 1.25rem;
	}

	.content :global(h2),
	.content :global(h3) {
		margin: 2rem 0 0.75rem;
		line-height: 1.3;
	}

	.content :global(ul),
	.content :global(ol) {
		padding-left: 1.5rem;
	}

	.content :global(a) {
		color: #0057b8;
	}
</style>

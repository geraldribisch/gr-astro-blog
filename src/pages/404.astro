---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Seite nicht gefunden" description="Die angeforderte Seite existiert nicht.">
	<section class="not-found">
		<h1>Seite nicht gefunden</h1>
		<p>Die Seite, die Sie suchen, gibt es nicht oder nicht mehr.</p>
		<p class="links">
			<a href="/">Zur Startseite</a>
			<a href="/blog">Zum Blog</a>
		</p>
	</section>
</BaseLayout>

<style>
	.not-found {
		padding: 3rem 0;
		text-align: center;
	}

	.not-found h1 {
		margin-bottom: 0.75rem;
	}

	.links {
		display: flex;
		justify-content: center;
		gap: 1.5rem;
		margin-top: 1.5rem;
	}
</style>

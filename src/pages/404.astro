---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
---

<BaseLayout title="Seite nicht gefunden" description="Die angeforderte Seite wurde nicht gefunden." noindex>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer grid min-h-[55vh] place-items-center py-16 text-center">
    <div>
      <p class="eyebrow">Fehler 404</p>
      <h1 class="pagehead-title">Seite nicht gefunden</h1>
      <p class="pagehead-description mx-auto">
        Der Beitrag wurde vielleicht verschoben, oder die Adresse ist falsch geschrieben.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/" class="btn btn-solid">Zur Startseite</a>
        <a href="/posts/" class="btn btn-outline">Zum Archiv</a>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

---
const links = [
	{ href: '/', label: 'Home' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/impressum', label: 'Impressum' },
	{ href: '/datenschutz', label: 'Datenschutz' },
];

// Abschließenden Schrägstrich entfernen, damit /blog und /blog/ gleich behandelt werden
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string): boolean {
	if (href === '/') return currentPath === '/';
	// Unterseiten (z. B. /blog/mein-post) markieren den übergeordneten Link
	return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="site-header">
	<nav class="nav" aria-label="Hauptnavigation">
		<a href="/" class="logo">Gerald Ribisch</a>
		<ul class="nav-links">
			{
				links.map(({ href, label }) => (
					<li>
						<a
							href={href}
							class:list={['nav-link', { active: isActive(href) }]}
							aria-current={isActive(href) ? 'page' : undefined}
						>
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	.site-header {
		background: #fff;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
	}

	.nav {
		max-width: 900px;
		margin: 0 auto;
		padding: 1rem 1.5rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
	}

	.logo {
		font-size: 1.25rem;
		font-weight: 700;
		color: #222;
		text-decoration: none;
	}

	.nav-links {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
	}

	.nav-link {
		display: inline-block;
		padding: 0.25rem 0;
		color: #555;
		text-decoration: none;
		border-bottom: 2px solid transparent;
		transition: color 0.2s, border-color 0.2s;
	}

	.nav-link:hover,
	.nav-link:focus-visible {
		color: #0057b8;
	}

	.nav-link.active {
		color: #0057b8;
		font-weight: 600;
		border-bottom-color: #0057b8;
	}

	@media (max-width: 600px) {
		.nav {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>

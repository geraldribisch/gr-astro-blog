---
import envelope from "@/icons/bootstrap/envelope.svg?raw";
import github from "@/icons/bootstrap/github.svg?raw";
import linkedin from "@/icons/bootstrap/linkedin.svg?raw";

const icons = {
  envelope,
  github,
  linkedin,
};

export type LocalIconName = keyof typeof icons;

interface Props {
  name: LocalIconName;
  className?: string;
}

const { name, className = "h-4 w-4" } = Astro.props;
const icon = icons[name];
---

<span
  class:list={["inline-grid place-items-center [&>svg]:h-full [&>svg]:w-full [&>svg]:fill-current", className]}
  aria-hidden="true"
  set:html={icon}
/>
